filters:
  and:
    - file.inFolder("Literature/Papers")
    - file.ext == "md"
    - type == "paper"
formulas:
  paper: file.asLink(title)
properties:
  formula.paper:
    displayName: Title
views:
  - type: table
    name: Inbox
    filters:
      and:
        - human_read_status == "unread"
    order:
      - formula.paper
      - authors
      - year
      - human_priority
      - human_relevance
      - ai_review_status
      - ai_recommendation
      - date_added
