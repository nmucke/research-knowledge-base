filters:
  and:
    - file.ext == "md"
formulas:
  project: file.asLink(title)
  paper: file.asLink(title)
properties:
  formula.project:
    displayName: Project
  formula.paper:
    displayName: Title
views:
  - type: table
    name: Projects
    filters:
      and:
        - file.inFolder("Projects")
        - type == "project"
    order:
      - formula.project
      - status
      - started
      - target
      - tags
    sort:
      - property: status
        direction: ASC
      - property: started
        direction: DESC
  - type: table
    name: Linked papers
    filters:
      and:
        - file.inFolder("Literature/Papers")
        - type == "paper"
        - note.projects
    order:
      - formula.paper
      - projects
      - year
      - human_read_status
      - ai_recommendation
      - ai_relevance
    sort:
      - property: human_read_status
        direction: ASC
  - type: table
    name: Unlinked reviewed papers
    filters:
      and:
        - file.inFolder("Literature/Papers")
        - type == "paper"
        - ai_review_status == "reviewed"
        - "!note.projects"
    order:
      - formula.paper
      - year
      - ai_recommendation
      - ai_relevance
      - tags
    sort:
      - property: ai_relevance
        direction: DESC
