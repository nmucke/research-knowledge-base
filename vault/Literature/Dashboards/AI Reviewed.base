filters:
  and:
    - file.inFolder("Literature/Papers")
    - file.ext == "md"
    - type == "paper"
formulas:
  paper: file.asLink(title)
properties:
  formula.paper:
    displayName: Title
views:
  - type: table
    name: AI Reviewed
    filters:
      and:
        - ai_review_status == "reviewed"
    order:
      - formula.paper
      - ai_recommendation
      - ai_relevance
      - ai_recommendation_confidence
      - ai_review_scope
      - ai_review_agent
      - ai_review_date
