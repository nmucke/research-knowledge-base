RESEARCH_VAULT_PATH=.
ZOTERO_LOCAL_API=http://localhost:23119/api
BETTER_BIBTEX_RPC=http://localhost:23119/better-bibtex/json-rpc
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LIBRARY_ID=0
RESEARCH_LOG_LEVEL=INFO
UNKNOWN_TAG_POLICY=error

# Optional write fallback for Zotero builds whose local API is read-only.
# Create a dedicated key with library write access at https://www.zotero.org/settings/keys
ZOTERO_WEB_API_KEY=
ZOTERO_WEB_LIBRARY_ID=

# Comma-separated subset of: domain, method, task, property, model, data
ALLOWED_TAG_NAMESPACES=domain,method,task,property,model,data
