formulas:
  paper: 'file.asLink(title)'
properties:
  formula.paper:
    displayName: Title
filters:
  and:
    - 'file.inFolder("Literature/Papers")'
    - 'file.ext == "md"'
    - 'type == "paper"'
views:
  - type: table
    name: Inbox
    filters:
      and:
        - 'human_read_status == "unread"'
    order:
      - formula.paper
      - note.authors
      - note.year
      - note.human_priority
      - note.human_relevance
      - note.ai_review_status
      - note.ai_recommendation
      - note.date_added
