filters:
  and:
    - file.inFolder("Literature/Papers")
    - file.ext == "md"
    - type == "paper"
formulas:
  paper: file.asLink(title)
properties:
  formula.paper:
    displayName: Title
views:
  - type: table
    name: Human Read
    filters:
      and:
        - human_read_status == "read"
    order:
      - formula.paper
      - authors
      - year
      - human_read_date
      - human_rating
      - human_relevance
      - ai_review_status
      - ai_recommendation
  - type: table
    name: Read but AI-unverified
    filters:
      and:
        - human_read_status == "read"
        - ai_review_status == "reviewed"
        - ai_review_human_verified == false
    order:
      - formula.paper
      - authors
      - year
      - ai_recommendation
      - ai_relevance
      - ai_review_date
